{
  "name": "vyrnex-studio",
  "productName": "Vyrnex Studio",
  "version": "0.3.0",
  "description": "A lightweight, local code editor built with Electron, Vite and Monaco.",
  "main": "dist/electron/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.json",
    "pack": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "monaco-editor": "^0.45.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.metrix31.vyrnexstudio",
    "productName": "Vyrnex Studio",
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ]
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0"
  }
}
